---
export interface Props {
  title: string;
  lang: 'en' | 'zh';
  description?: string;
}

const { title, lang, description } = Astro.props;
const isEn = lang === 'en';

const nav = {
  home: isEn ? 'Home' : '首頁',
  about: isEn ? 'About' : '關於我們',
  courses: isEn ? 'Courses' : '球場',
  competitions: isEn ? 'Competitions' : '比賽',
  membership: isEn ? 'Membership' : '會籍',
  visitors: isEn ? 'Visitors' : '訪客',
  facilities: isEn ? 'Facilities' : '設施',
  gallery: isEn ? 'Gallery' : '相簿',
  news: isEn ? 'News' : '新聞',
  contact: isEn ? 'Contact' : '聯絡我們',
};

const apply = isEn ? 'APPLY TO COMPETITION' : '比賽報名';
const otherLang = isEn ? 'zh' : 'en';
const otherLabel = isEn ? '中文' : 'EN';

function localPath(path: string) {
  return `/${lang}${path}`;
}

function otherLangPath(path: string) {
  return `/${otherLang}${path}`;
}

const currentPath = Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/';
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Macau Golf Club</title>
  <meta name="description" content={description || title} />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <header>
    <nav class="nav" aria-label="Main navigation">
      <div class="container nav-inner">
        <a href={localPath('/')} class="nav-logo">
          <span class="nav-logo-text">Macau Golf Club</span>
          <span class="nav-logo-sub">澳門高爾夫球會</span>
        </a>
        <ul class="nav-links">
          <li><a href={localPath('/')}>{nav.home}</a></li>
          <li><a href={localPath('/about/')}>{nav.about}</a></li>
          <li><a href={localPath('/courses/')}>{nav.courses}</a></li>
          <li><a href={localPath('/competitions/')}>{nav.competitions}</a></li>
          <li><a href={localPath('/membership/')}>{nav.membership}</a></li>
          <li><a href={localPath('/visitors/')}>{nav.visitors}</a></li>
          <li><a href={localPath('/facilities/')}>{nav.facilities}</a></li>
          <li><a href={localPath('/gallery/')}>{nav.gallery}</a></li>
          <li><a href={localPath('/news/')}>{nav.news}</a></li>
          <li><a href={localPath('/contact/')}>{nav.contact}</a></li>
        </ul>
        <div class="nav-actions">
          <button class="btn btn-cta nav-cta" id="openCompetitionModal">{apply}</button>
          <a href={otherLangPath(currentPath)} class="nav-lang">{otherLabel}</a>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <p>Macau Golf Club</p>
        <p>澳門高爾夫球會</p>
      </div>
      <div class="footer-links">
        <a href={localPath('/contact/')}>{isEn ? 'Contact' : '聯絡我們'}</a>
        <a href="#">{isEn ? 'Privacy Policy' : '私隱政策'}</a>
      </div>
      <p class="footer-copy">&copy; 2026 Macau Golf Club</p>
    </div>
  </footer>

  <!-- Competition Modal -->
  <div id="competition-modal" class="modal" hidden>
    <div class="modal-overlay" id="modalOverlay"></div>
    <div class="modal-content">
      <button class="modal-close" id="closeModal" aria-label="Close">&times;</button>
      <h2 class="modal-title">Competition Application</h2>

      <form
        name="competition"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you/"
        class="competition-form"
      >
        <input type="hidden" name="form-name" value="competition" />
        <p class="visually-hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="form-group">
          <label for="fullName">Full Name *</label>
          <input type="text" id="fullName" name="fullName" required />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label for="phone">Phone *</label>
            <input type="tel" id="phone" name="phone" required />
          </div>
        </div>

        <div class="form-group">
          <label for="competition">Competition *</label>
          <select id="competition" name="competition" required>
            <option value="">Select a competition...</option>
            <option value="Macau Open 2026">Macau Open 2026</option>
            <option value="Club Championship 2026">Club Championship 2026</option>
            <option value="Member-Guest Tournament">Member-Guest Tournament</option>
            <option value="Junior Open">Junior Open</option>
            <option value="Other">Other / General Inquiry</option>
          </select>
        </div>

        <div class="form-group">
          <label for="handicap">Handicap / GHIN (if applicable)</label>
          <input type="text" id="handicap" name="handicap" placeholder="e.g. 12.5" />
        </div>

        <div class="form-group">
          <label for="message">Message (optional)</label>
          <textarea id="message" name="message" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-primary form-submit">SUBMIT APPLICATION</button>

        <p class="form-note">We'll email you to confirm your application.</p>
      </form>
    </div>
  </div>

  <style>
    .nav {
      background: var(--color-dark);
      color: var(--color-white);
      padding: 0.5rem 0;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nav-inner {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .nav-logo {
      text-decoration: none;
      color: var(--color-white);
      flex-shrink: 0;
    }
    .nav-logo-text {
      display: block;
      font-size: 1rem;
      font-weight: 300;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .nav-logo-sub {
      display: block;
      font-size: 0.65rem;
      color: var(--color-accent);
    }
    .nav-links {
      display: flex;
      list-style: none;
      gap: 0.25rem;
      flex-wrap: wrap;
      margin-left: auto;
    }
    .nav-links a {
      color: var(--color-white);
      font-size: 0.78rem;
      padding: 0.3rem 0.5rem;
      border-radius: var(--radius);
      white-space: nowrap;
    }
    .nav-links a:hover {
      background: rgba(255,255,255,0.1);
      text-decoration: none;
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }
    .nav-cta {
      font-size: 0.7rem;
      padding: 5px 10px;
    }
    .nav-lang {
      color: var(--color-accent);
      font-size: 0.75rem;
      padding: 0.3rem 0.5rem;
    }

    .footer {
      background: var(--color-dark);
      color: var(--color-white);
      padding: 2rem 0;
      margin-top: auto;
    }
    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
    }
    .footer-brand p { margin: 0; }
    .footer-links { display: flex; gap: 1rem; }
    .footer-links a { color: var(--color-accent); }
    .footer-copy { color: rgba(255,255,255,0.5); margin: 0; }

    .modal {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: none;
    }
    .modal.open {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.5);
    }
    .modal-content {
      position: relative;
      background: var(--color-white);
      padding: 2rem;
      border-radius: 8px;
      max-width: 520px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
    }

    @media (max-width: 768px) {
      .nav-inner { flex-wrap: wrap; }
      .nav-links { order: 3; width: 100%; justify-content: center; }
      .footer-inner { flex-direction: column; gap: 0.5rem; text-align: center; }
    }
  </style>

  <style>
    .modal-close {
      position: absolute;
      top: 0.75rem;
      right: 1rem;
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: var(--color-muted);
    }
    .modal-title {
      font-size: 1.3rem;
      margin-bottom: 1.5rem;
      padding-right: 2rem;
    }

    .competition-form { display: flex; flex-direction: column; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.25rem; }
    .form-group label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--color-dark);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 0.6rem 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      font-size: 0.9rem;
      font-family: inherit;
      background: var(--color-white);
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px rgba(13,94,110,0.2);
    }
    .form-row { display: flex; gap: 1rem; }
    .form-row .form-group { flex: 1; }
    .form-submit { width: 100%; padding: 0.75rem; font-size: 0.9rem; }
    .form-note {
      font-size: 0.75rem;
      color: var(--color-muted);
      text-align: center;
      margin: 0;
    }

    @media (max-width: 500px) {
      .form-row { flex-direction: column; }
    }
  </style>

  <script>
    (function() {
      const modal = document.getElementById('competition-modal');
      if (!modal) return;

      const overlay = document.getElementById('modalOverlay');
      const closeBtn = document.getElementById('closeModal');

      function openModal() { modal.classList.add('open'); }
      function closeModal() { modal.classList.remove('open'); }

      document.querySelectorAll('[id$="ApplyBtn"], #openCompetitionModal').forEach(function(btn) {
        btn.addEventListener('click', openModal);
      });

      overlay?.addEventListener('click', closeModal);
      closeBtn?.addEventListener('click', closeModal);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
      });
    })();
  </script>
</body>
</html>
