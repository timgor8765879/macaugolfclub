---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="相簿" lang="zh">
  <section class="section page-hero">
    <div class="container">
      <h1>相簿</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p>通過照片探索我們的球場和設施。更多圖片即將推出。</p>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem;">
        <div class="card" style="text-align: center; padding: 3rem 1rem;">球場景觀</div>
        <div class="card" style="text-align: center; padding: 3rem 1rem;">會所</div>
        <div class="card" style="text-align: center; padding: 3rem 1rem;">活動</div>
        <div class="card" style="text-align: center; padding: 3rem 1rem;">練習區</div>
        <div class="card" style="text-align: center; padding: 3rem 1rem;">比賽</div>
        <div class="card" style="text-align: center; padding: 3rem 1rem;">餐飲</div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.7), rgba(13,94,110,0.65)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="%23ff7b42"/><stop offset="0.5" stop-color="%23ffb344"/><stop offset="1" stop-color="%235a9ec5"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><polygon points="0,240 200,200 400,230 600,190 800,220 1000,195 1200,215 1200,400 0,400" fill="%233d6b2e"/><polygon points="0,280 180,255 350,275 550,245 750,270 950,250 1200,265 1200,400 0,400" fill="%23356b22"/><circle cx="600" cy="70" r="60" fill="%23ff8c42" opacity="0.7"/><circle cx="600" cy="70" r="40" fill="%23ffb344"/></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
  @media (max-width: 768px) {
    .container > div { grid-template-columns: 1fr 1fr !important; }
  }
</style>
