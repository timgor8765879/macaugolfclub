---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About the Club" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>About the Club</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p>Founded with a passion for the game, Macau Golf Club has been a cornerstone of the Macau sporting community. Our club blends tradition with modern amenities to provide an exceptional golf experience.</p>
      <p>Located in a stunning natural setting, our course offers challenging play for golfers of all levels, complemented by first-class clubhouse facilities.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-dark), var(--color-primary));
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
