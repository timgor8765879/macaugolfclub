---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About the Club" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>About the Club</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p>Founded with a passion for the game, Macau Golf Club has been a cornerstone of the Macau sporting community. Our club blends tradition with modern amenities to provide an exceptional golf experience.</p>
      <p>Located in a stunning natural setting, our course offers challenging play for golfers of all levels, complemented by first-class clubhouse facilities.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.75), rgba(13,94,110,0.7)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="%235a9ec5"/><stop offset="1" stop-color="%23b5d99c"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><polygon points="0,280 200,240 350,260 500,220 700,250 900,210 1100,240 1200,220 1200,400 0,400" fill="%234a8c3f"/><polygon points="0,310 150,280 300,300 450,270 600,295 800,265 1000,290 1200,270 1200,400 0,400" fill="%233d7a2e"/><rect x="0" y="340" width="1200" height="60" fill="%23356b22"/><rect x="480" y="140" width="80" height="100" fill="%23d4c5a0"/><polygon points="480,140 520,90 560,140" fill="%2394754a"/><rect x="540" y="160" width="20" height="80" fill="%23c4b590"/><polygon points="540,160 550,130 560,160" fill="%23806040"/><circle cx="180" cy="80" r="35" fill="%23f5e8c0" opacity="0.9"/></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
