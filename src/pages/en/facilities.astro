---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Facilities" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>Facilities</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="card" style="margin-bottom: 1rem;"><h3>Clubhouse</h3><p>Our modern clubhouse features locker rooms, lounges, and panoramic views of the course.</p></div>
      <div class="card" style="margin-bottom: 1rem;"><h3>Dining</h3><p>Enjoy fine dining at our restaurant, or relax with a drink at the 19th hole bar.</p></div>
      <div class="card" style="margin-bottom: 1rem;"><h3>Pro Shop</h3><p>Fully stocked with the latest equipment, apparel, and accessories from top brands.</p></div>
      <div class="card"><h3>Practice Areas</h3><p>Driving range, putting green, chipping area, and PGA professional instruction available.</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.75), rgba(13,94,110,0.72)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="%2390b8d0"/><stop offset="1" stop-color="%23d0e8c0"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><rect x="350" y="160" width="500" height="180" fill="%23d4c5a0"/><polygon points="350,160 600,80 850,160" fill="%2394754a"/><rect x="400" y="200" width="60" height="80" fill="%23806040"/><rect x="520" y="200" width="60" height="80" fill="%23806040"/><rect x="640" y="200" width="60" height="80" fill="%23806040"/><rect x="740" y="200" width="60" height="80" fill="%23806040"/><rect x="0" y="300" width="1200" height="100" fill="%234a8c3f"/><ellipse cx="600" cy="330" rx="300" ry="50" fill="%233d7a2e"/></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
