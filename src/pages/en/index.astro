---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" lang="en" description="Macau Golf Club — a championship experience in the heart of Macau">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Macau Golf Club</h1>
      <p class="hero-tagline">A championship experience in the heart of Macau</p>
    </div>
  </section>

  <!-- Welcome -->
  <section class="section">
    <div class="container">
      <h2>Welcome to Macau Golf Club</h2>
      <p>Nestled in Macau's stunning landscape, our club offers world-class golfing, exceptional facilities, and a warm community. Whether you're a seasoned golfer or new to the game, Macau Golf Club welcomes you.</p>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="section" style="background: var(--color-white);">
    <div class="container">
      <div class="quick-links">
        <a href="/en/courses/" class="card quick-link">
          <h3>Our Courses</h3>
          <p>Explore Macau's finest fairways, designed for golfers of every level.</p>
        </a>
        <a href="/en/competitions/" class="card quick-link">
          <h3>Competitions</h3>
          <p>View upcoming tournaments and events. Test your skills.</p>
        </a>
        <a href="/en/membership/" class="card quick-link">
          <h3>Membership</h3>
          <p>Join our community and enjoy exclusive benefits year-round.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Competition Banner -->
  <section class="section competition-banner">
    <div class="container">
      <h2>Upcoming: Macau Open 2026</h2>
      <p>Registration is now open. Secure your spot in Macau's premier golf tournament.</p>
      <button class="btn btn-cta" id="heroApplyBtn">Enquire Now</button>
    </div>
  </section>

  <!-- News Snippet -->
  <section class="section">
    <div class="container">
      <h2>Latest News</h2>
      <div class="news-grid">
        <div class="card">
          <h3>Course Renovation Complete</h3>
          <p>Our back nine has been refreshed with new bunkering and greens. Come play a round and see the changes.</p>
        </div>
        <div class="card">
          <h3>Junior Program Launches</h3>
          <p>Introducing our new junior development program — building the next generation of Macau golfers.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 70vh;
    min-height: 400px;
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-primary) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><defs><linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="%235a9ec5"/><stop offset="1" stop-color="%23b5d99c"/></linearGradient></defs><rect fill="url(%23sky)" width="1200" height="600"/><circle cx="200" cy="80" r="50" fill="%23fff8dc" opacity="0.9"/><polygon points="0,320 200,280 350,300 500,260 700,290 900,250 1100,280 1200,270 1200,600 0,600" fill="%234a8c3f"/><polygon points="0,380 180,340 320,360 480,330 650,355 850,325 1050,350 1200,340 1200,600 0,600" fill="%233d7a2e"/><rect x="0" y="450" width="1200" height="150" fill="%23356b22"/><ellipse cx="750" cy="290" rx="60" ry="18" fill="%23d4b87a"/><rect x="747" y="230" width="6" height="60" fill="%23333"/><polygon points="753,230 762,242 744,242" fill="%23e74c3c"/><rect x="380" y="240" width="130" height="80" fill="%23d4c5a0"/><polygon points="380,240 445,185 510,240" fill="%2394754a"/></svg>') center/cover;
    opacity: 0.35;
  }
  .hero-content {
    position: relative;
    text-align: center;
    color: var(--color-white);
    padding: 2rem;
  }
  .hero-content h1 {
    font-size: 3rem;
    color: var(--color-white);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 200;
  }
  .hero-tagline {
    font-size: 1.2rem;
    font-weight: 300;
    font-style: italic;
    margin-top: 0.5rem;
    color: var(--color-accent);
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .quick-link {
    text-decoration: none;
    transition: transform 0.2s;
  }
  .quick-link:hover {
    transform: translateY(-3px);
    text-decoration: none;
  }

  .competition-banner {
    background: linear-gradient(135deg, var(--color-dark), var(--color-primary));
    color: var(--color-white);
    text-align: center;
  }
  .competition-banner h2 { color: var(--color-white); }
  .competition-banner p { color: rgba(255,255,255,0.8); }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .hero-content h1 { font-size: 2rem; }
    .quick-links { grid-template-columns: 1fr; }
    .news-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.getElementById('heroApplyBtn')?.addEventListener('click', () => {
    document.getElementById('competition-modal')?.classList.add('open');
  });
</script>
