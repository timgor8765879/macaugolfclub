---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Membership" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>Membership</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Why Join?</h2>
      <p>Membership at Macau Golf Club opens the door to an exceptional golfing lifestyle. Enjoy unlimited access to our championship course, exclusive events, and a welcoming community of fellow golf enthusiasts.</p>
      <h2>Membership Categories</h2>
      <div class="card" style="margin-bottom: 1rem;"><h3>Full Membership</h3><p>Unlimited golf, access to all club facilities, voting rights, and guest privileges.</p></div>
      <div class="card" style="margin-bottom: 1rem;"><h3>Junior Membership</h3><p>For golfers under 18. Full course access with developmental programs.</p></div>
      <div class="card"><h3>Corporate Membership</h3><p>Entertain clients and reward employees with corporate golf privileges.</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.75), rgba(13,94,110,0.7)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="%23a8d8ea"/><stop offset="1" stop-color="%23c5e8b4"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><path d="M0,250 Q250,210 500,240 T1000,220 T1200,235 L1200,400 L0,400Z" fill="%235a8f3c"/><path d="M0,290 Q200,265 450,280 T900,260 T1200,275 L1200,400 L0,400Z" fill="%234a7c2e"/><circle cx="300" cy="260" r="25" fill="%23c4b590"/><circle cx="700" cy="250" r="20" fill="%23c4b590"/><rect x="230" y="180" width="140" height="70" fill="%23d4c5a0"/><polygon points="230,180 300,130 370,180" fill="%2394754a"/><rect x="680" y="195" width="100" height="55" fill="%23d4c5a0"/><polygon points="680,195 730,155 780,195" fill="%2394754a"/></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
