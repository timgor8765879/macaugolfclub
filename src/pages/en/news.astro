---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="News & Events" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>News & Events</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="card" style="margin-bottom: 1.5rem;">
        <h3>Course Renovation Complete</h3>
        <p style="color: var(--color-muted); font-size: 0.85rem;">May 2026</p>
        <p>Our back nine has been refreshed with new bunkering and greens. The renovated holes are now open for play.</p>
      </div>
      <div class="card" style="margin-bottom: 1.5rem;">
        <h3>Junior Program Launches</h3>
        <p style="color: var(--color-muted); font-size: 0.85rem;">April 2026</p>
        <p>Introducing our new junior development program, designed to nurture the next generation of Macau golfers.</p>
      </div>
      <div class="card">
        <h3>Macau Open 2026 Announced</h3>
        <p style="color: var(--color-muted); font-size: 0.85rem;">March 2026</p>
        <p>Save the date! This year's Macau Open will be bigger than ever. Registration details coming soon.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.76), rgba(13,94,110,0.72)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="%235580b5"/><stop offset="1" stop-color="%23a8d8a0"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><path d="M0,230 Q300,195 600,220 T1200,200 L1200,400 L0,400Z" fill="%234a8c3f"/><path d="M0,270 Q250,245 500,265 T1000,245 T1200,258 L1200,400 L0,400Z" fill="%233d7a2e"/><circle cx="550" cy="185" r="12" fill="%23fff"/><circle cx="650" cy="180" r="10" fill="%23fff"/><ellipse cx="400" cy="270" rx="30" ry="10" fill="%23d4b87a"/></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
