---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Visitors" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>Visitors</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Plan Your Visit</h2>
      <p>Macau Golf Club welcomes visitors throughout the year. Whether you're a traveling golfer or a local resident, we invite you to experience our course and facilities.</p>
      <h2>Green Fees</h2>
      <p>Weekday: MOP 800 | Weekend: MOP 1,200</p>
      <p>Includes cart rental and access to practice facilities.</p>
      <h2>Dress Code</h2>
      <p>Collared shirts, tailored trousers or shorts, and golf shoes are required on the course. No denim please.</p>
      <h2>Tee Time Booking</h2>
      <p>Contact us to reserve your tee time. Advance booking recommended, especially on weekends.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.72), rgba(13,94,110,0.68)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="%236bb5d9"/><stop offset="1" stop-color="%23c8e8b0"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><polygon points="0,220 300,190 600,210 900,185 1200,200 1200,400 0,400" fill="%236aa84f"/><polygon points="0,260 250,235 500,255 800,230 1100,250 1200,240 1200,400 0,400" fill="%234a8c3f"/><ellipse cx="600" cy="195" rx="60" ry="16" fill="%23d4b87a"/><rect x="597" y="145" width="6" height="50" fill="%23333"/><polygon points="603,145 612,155 594,155" fill="%23e74c3c"/><circle cx="200" cy="60" r="40" fill="%23ffe8a0" opacity="0.8"/></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
