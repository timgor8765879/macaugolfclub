---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Courses" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>Our Courses</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Championship Course</h2>
      <p>Our flagship 18-hole championship course offers a challenging yet rewarding experience. Designed to blend with the natural Macau landscape, each hole presents a unique test of skill and strategy.</p>
      <h2>Practice Facilities</h2>
      <p>Warm up at our driving range, practice your short game on our chipping and putting greens, or take a lesson with one of our PGA professionals.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.75), rgba(13,94,110,0.7)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="%2387CEEB"/><stop offset="1" stop-color="%23d4e8c0"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><ellipse cx="600" cy="400" rx="700" ry="180" fill="%236aa84f"/><path d="M0,280 Q300,240 600,260 T1200,230 L1200,400 L0,400Z" fill="%234a8c3f"/><ellipse cx="750" cy="220" rx="70" ry="22" fill="%233d7a2e"/><rect x="747" y="160" width="6" height="60" fill="%23222"/><polygon points="753,160 762,172 744,172" fill="%23e74c3c"/><ellipse cx="400" cy="310" rx="45" ry="15" fill="%23d4b87a"/><ellipse cx="550" cy="315" rx="35" ry="12" fill="%23d4b87a"/></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
