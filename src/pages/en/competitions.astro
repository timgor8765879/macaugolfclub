---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Competitions" lang="en">
  <section class="section page-hero">
    <div class="container">
      <h1>Competitions</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="card" style="margin-bottom: 1.5rem;">
        <h3>Macau Open 2026</h3>
        <p>Our premier annual tournament. Open to all golfers with a valid handicap. Registration now open.</p>
        <button class="btn btn-cta" style="margin-top: 0.5rem;" onclick="document.getElementById('competition-modal').classList.add('open')">Enquire Now</button>
      </div>
      <div class="card" style="margin-bottom: 1.5rem;">
        <h3>Club Championship</h3>
        <p>Members-only stroke play championship. Defend your title or challenge for the crown.</p>
        <button class="btn btn-cta" style="margin-top: 0.5rem;" onclick="document.getElementById('competition-modal').classList.add('open')">Enquire Now</button>
      </div>
      <div class="card">
        <h3>Member-Guest Tournament</h3>
        <p>Bring a guest and compete in our popular pairs event. Dinner and prizes included.</p>
        <button class="btn btn-cta" style="margin-top: 0.5rem;" onclick="document.getElementById('competition-modal').classList.add('open')">Enquire Now</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(27,58,75,0.78), rgba(13,94,110,0.7)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><linearGradient id="s" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="%23ffd700"/><stop offset="1" stop-color="%23e8962e"/></linearGradient></defs><rect fill="url(%23s)" width="1200" height="400"/><rect y="200" width="1200" height="200" fill="%234a8c3f"/><ellipse cx="600" cy="200" rx="400" ry="80" fill="%233d7a2e"/><polygon points="550,160 600,70 650,160" fill="%23ffd700"/><rect x="596" y="160" width="8" height="40" fill="%23c9a800"/><circle cx="600" cy="120" r="25" fill="none" stroke="%23ffd700" stroke-width="3"/><text x="600" y="135" text-anchor="middle" fill="%23ffd700" font-size="24" font-weight="bold">1</text></svg>') center/cover no-repeat;
    color: var(--color-white);
    padding: 3rem 0;
  }
  .page-hero h1 { color: var(--color-white); }
</style>
